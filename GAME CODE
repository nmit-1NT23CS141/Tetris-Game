// ══════════════════════════════════════════
// BOARD / UTILS
// ══════════════════════════════════════════
function newBoard(){return Array.from({length:ROWS},()=>new Array(COLS).fill(0));}
function randPiece(){return Math.floor(Math.random()*7)+1;}
function cloneBoard(b){return b.map(r=>r.slice());}
function rotateMatrix(p){return p[0].map((_,i)=>p.map(r=>r[i]).reverse());}
function allRotations(p){
  const rots=[],seen=new Set();let cur=p;
  for(let i=0;i<4;i++){const k=cur.flat().join(',');if(!seen.has(k)){seen.add(k);rots.push(cur);}cur=rotateMatrix(cur);}
  return rots;
}
 
// ══════════════════════════════════════════
// AI ENGINE — Greedy Heuristic
// ══════════════════════════════════════════
const W={holes:-0.72,height:-0.51,bumpiness:-0.18,lines:0.76};
 
function evaluateBoard(b){
  const heights=new Array(COLS).fill(0);
  for(let c=0;c<COLS;c++)for(let r=0;r<ROWS;r++)if(b[r][c]){heights[c]=ROWS-r;break;}
  const aggH=heights.reduce((a,h)=>a+h,0);
  let holes=0;
  for(let c=0;c<COLS;c++){let bl=false;for(let r=0;r<ROWS;r++){if(b[r][c])bl=true;else if(bl)holes++;}}
  let bump=0;
  for(let c=0;c<COLS-1;c++)bump+=Math.abs(heights[c]-heights[c+1]);
  let lns=0;
  for(let r=0;r<ROWS;r++)if(b[r].every(c=>c))lns++;
  return W.holes*holes+W.height*aggH+W.bumpiness*bump+W.lines*lns;
}
 
function lockPieceOnBoard(p,px,py,b){
  p.forEach((row,dr)=>row.forEach((v,dc)=>{if(v)b[py+dr][px+dc]=1;}));
  let cleared=0;
  for(let r=ROWS-1;r>=0;r--){
    if(b[r].every(c=>c)){b.splice(r,1);b.unshift(new Array(COLS).fill(0));cleared++;r++;}
  }
  return cleared;
}
 
/** Returns all legal moves sorted by score descending.
 *  Each entry: { rot, rotIdx, col, y, score, lines, piece }
 */
function getAllMoves(p,b){
  const rots=allRotations(p);
  const moves=[];
  rots.forEach((rot,ri)=>{
    for(let x=-2;x<COLS+2;x++){
      if(!canPlace(rot,x,0,b))continue;
      let y=0;while(canPlace(rot,x,y+1,b))y++;
      const sim=cloneBoard(b);
      const lns=lockPieceOnBoard(rot,x,y,sim);
      const s=evaluateBoard(sim);
      moves.push({rot,rotIdx:ri,col:x,y,score:s,lines:lns,piece:rot});
    }
  });
  moves.sort((a,b)=>b.score-a.score);
  return moves;
}
 
function findBestMove(p,b){
  const moves=getAllMoves(p,b);
  return moves.length>0?{rot:moves[0].rotIdx,col:moves[0].col}:{rot:0,col:0};
}
 
// ══════════════════════════════════════════
// DRAWING
// ══════════════════════════════════════════
function drawBlock(c,x,y,color,size=BLOCK){
  c.fillStyle=color;c.fillRect(x*size+1,y*size+1,size-2,size-2);
  c.fillStyle='rgba(255,255,255,0.22)';c.fillRect(x*size+1,y*size+1,size-2,4);
  c.fillStyle='rgba(0,0,0,0.3)';c.fillRect(x*size+1,y*size+size-5,size-2,4);
}
 
function drawBoard(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#06060f';ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.strokeStyle='rgba(255,255,255,0.035)';ctx.lineWidth=0.5;
  for(let r=0;r<ROWS;r++){ctx.beginPath();ctx.moveTo(0,r*BLOCK);ctx.lineTo(COLS*BLOCK,r*BLOCK);ctx.stroke();}
  for(let c=0;c<COLS;c++){ctx.beginPath();ctx.moveTo(c*BLOCK,0);ctx.lineTo(c*BLOCK,ROWS*BLOCK);ctx.stroke();}
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)if(board&&board[r][c])drawBlock(ctx,c,r,COLORS[board[r][c]]);
 
  if(piece){
    let gy=pieceY;
    while(canPlace(piece,pieceX,gy+1))gy++;
    if(gy!==pieceY){
      ctx.globalAlpha=0.17;
      piece.forEach((row,dr)=>row.forEach((v,dc)=>{if(v)drawBlock(ctx,pieceX+dc,gy+dr,COLORS[pieceType]);}));
      ctx.globalAlpha=1;
    }
    piece.forEach((row,dr)=>row.forEach((v,dc)=>{if(v)drawBlock(ctx,pieceX+dc,pieceY+dr,COLORS[pieceType]);}));
  }
 
  // draw move overlays (behind hint)
  if(movesActive) drawMoveOverlays();
  // draw hint overlay (on top)
  if(hintActive) drawHint();
}
 
function drawPreview(){
  pCtx.clearRect(0,0,pCanvas.width,pCanvas.height);
  pCtx.fillStyle='#06060f';pCtx.fillRect(0,0,pCanvas.width,pCanvas.height);
  if(!nextType)return;
  const p=PIECES[nextType],sz=20;
  const ox=Math.floor((pCanvas.width/sz-p[0].length)/2);
  const oy=Math.floor((pCanvas.height/sz-p.length)/2);
  p.forEach((row,r)=>row.forEach((v,c)=>{
    if(v){
      pCtx.fillStyle=COLORS[nextType];
      pCtx.fillRect((ox+c)*sz+1,(oy+r)*sz+1,sz-2,sz-2);
      pCtx.fillStyle='rgba(255,255,255,0.22)';
      pCtx.fillRect((ox+c)*sz+1,(oy+r)*sz+1,sz-2,4);
    }
  }));
}
 
// ══════════════════════════════════════════
// ── ALL MOVES FEATURE ─────────────────────
// ══════════════════════════════════════════
let movesActive   = false;
let cachedMoves   = [];        // sorted move list
let hoveredMove   = null;      // index into cachedMoves, for canvas highlight
let hintAnimFrame = null;
 
// Colour ramp: best=green → mid=yellow → worst=red
function scoreColor(norm){
  // norm 0..1 (1=best)
  if(norm>0.66) return `rgba(45,232,130,${0.55+norm*0.35})`;
  if(norm>0.33) return `rgba(255,214,0,${0.45+norm*0.4})`;
  return `rgba(255,80,80,${0.35+norm*0.35})`;
}
 
function drawMoveOverlays(){
  if(!movesActive||!cachedMoves.length)return;
  const best =cachedMoves[0].score;
  const worst=cachedMoves[cachedMoves.length-1].score;
  const range=best-worst||1;
 
  // Draw top-N ghost placements on the board canvas
  const topN = Math.min(cachedMoves.length, 8);
  cachedMoves.slice(0,topN).forEach((mv,i)=>{
    const norm=(mv.score-worst)/range;
    const isHovered=(i===hoveredMove);
    const isBest=(i===0);
    const alpha=isHovered?0.55:(isBest?0.42:Math.max(0.1,0.32-i*0.03));
    const col=scoreColor(norm);
 
    mv.piece.forEach((row,dr)=>row.forEach((v,dc)=>{
      if(!v)return;
      const px=(mv.col+dc)*BLOCK,py=(mv.y+dr)*BLOCK;
      // fill
      ctx.fillStyle=col.replace(/[\d.]+\)$/,`${alpha})`);
      ctx.fillRect(px+1,py+1,BLOCK-2,BLOCK-2);
      // border
      ctx.strokeStyle=col.replace(/[\d.]+\)$/,`${Math.min(1,alpha+0.4)})`);
      ctx.lineWidth=isBest?2:1;
      ctx.strokeRect(px+2,py+2,BLOCK-4,BLOCK-4);
    }));
 
    // Score label above the piece (only top-3 or hovered)
    if(i<3||isHovered){
      const topR=mv.piece.findIndex(r=>r.some(v=>v));
      const midC=mv.col+mv.piece[0].length/2;
      const lx=midC*BLOCK;
      const ly=(mv.y+topR)*BLOCK-3;
      if(ly>8){
        ctx.save();
        ctx.font=`bold ${isBest?10:9}px Courier New`;
        ctx.fillStyle=isBest?'#FFD600':'#ccc';
        ctx.shadowColor=isBest?'#FFD600':'transparent';
        ctx.shadowBlur=isBest?8:0;
        ctx.textAlign='center';
        ctx.fillText(mv.score.toFixed(1), lx, ly);
        ctx.restore();
      }
    }
  });
}
 
function buildMovesPanel(moves){
  const list=document.getElementById('moves-list');
  const count=document.getElementById('moves-count');
  list.innerHTML='';
  count.textContent=moves.length+' moves';
 
  if(!moves.length){list.innerHTML='<div style="color:#555577;font-size:10px;padding:4px">No legal moves</div>';return;}
 
  const best =moves[0].score;
  const worst=moves[moves.length-1].score;
  const range=best-worst||1;
  const topN =Math.min(moves.length,12);
 
  moves.slice(0,topN).forEach((mv,i)=>{
    const norm=(mv.score-worst)/range;
    const barColor=scoreColor(norm);
    const barW=Math.round(norm*100);
 
    // rank label
    const rankClass=i===0?'best':i===1?'rank2':i===2?'rank3':'';
    const rankText=i===0?'★':`#${i+1}`;
 
    // rotation label
    const rotLabels=['0°','90°','180°','270°'];
    const rotLabel=rotLabels[mv.rotIdx]||`R${mv.rotIdx}`;
 
    const row=document.createElement('div');
    row.className='move-row';
    row.title=`Col ${mv.col+1}, Rot ${rotLabel} → Score: ${mv.score.toFixed(2)}, Lines: ${mv.lines}`;
 
    // colour swatch = piece colour with rotation tint
    const swatchColor=COLORS[pieceType];
 
    row.innerHTML=`
      <div class="move-rank ${rankClass}">${rankText}</div>
      <div class="move-swatch" style="background:${swatchColor};opacity:${0.5+norm*0.5}"></div>
      <div class="move-bar-wrap">
        <div class="move-bar" style="width:${barW}%;background:${barColor}"></div>
      </div>
      <div class="move-score" style="color:${barColor}">${mv.score.toFixed(1)}</div>
      <div class="move-label">c${mv.col+1} ${rotLabel}${mv.lines?` +${mv.lines}L`:''}</div>
    `;
 
    // hover → highlight that move on board
    row.addEventListener('mouseenter',()=>{hoveredMove=i;drawBoard();});
    row.addEventListener('mouseleave',()=>{hoveredMove=null;drawBoard();});
    // click → apply move as current ghost target (player still places)
    row.addEventListener('click',()=>applyMoveHint(mv));
 
    list.appendChild(row);
  });
 
  if(moves.length>topN){
    const more=document.createElement('div');
    more.style.cssText='font-size:9px;color:#333355;text-align:center;padding:4px 0;';
    more.textContent=`+${moves.length-topN} more moves not shown`;
    list.appendChild(more);
  }
}
 
function applyMoveHint(mv){
  // Set hint overlay to this chosen move (no auto-drop)
  hintData={piece:mv.piece,x:mv.col,y:mv.y};
  hintActive=true;
  document.getElementById('btn-hint').classList.add('active');
  const t=document.getElementById('hint-toast');
  t.textContent=`📊 Showing move: col ${mv.col+1}, score ${mv.score.toFixed(1)}`;
  t.style.display='block';t.style.animation='hintPop 0.3s ease';
  clearTimeout(hintToastTimer);
  hintToastTimer=setTimeout(()=>t.style.display='none',3000);
  cancelAnimationFrame(hintAnimFrame);hintAnimate();
}
 
function toggleMoves(){
  if(!running||paused||aiEnabled)return;
  movesActive=!movesActive;
  const btn=document.getElementById('btn-moves');
  const panel=document.getElementById('moves-panel');
  if(movesActive){
    btn.classList.add('active');btn.textContent='📊 Hide Moves';
    cachedMoves=getAllMoves(piece,board);
    buildMovesPanel(cachedMoves);
    panel.style.display='block';
    // start animation loop for overlays
    cancelAnimationFrame(hintAnimFrame);hintAnimate();
  } else {
    hideMoves();
  }
}
 
function hideMoves(){
  movesActive=false;hoveredMove=null;cachedMoves=[];
  document.getElementById('btn-moves').classList.remove('active');
  document.getElementById('btn-moves').textContent='📊 All Moves';
  document.getElementById('moves-panel').style.display='none';
  if(running)drawBoard();
}
 
function refreshMovesIfOpen(){
  if(!movesActive)return;
  cachedMoves=getAllMoves(piece,board);
  buildMovesPanel(cachedMoves);
}
 
// ══════════════════════════════════════════
// HINT SYSTEM
// ══════════════════════════════════════════
const MAX_HINTS=3;
let hintsLeft=MAX_HINTS;
let hintActive=false,hintData=null,hintTimer=null,hintToastTimer=null;
 
function updateHintUI(){
  const btn=document.getElementById('btn-hint');
  const badge=document.getElementById('hint-badge');
  const left=document.getElementById('ai-hints-left');
  badge.textContent=hintsLeft;
  left.textContent=hintsLeft;
  const movBtn=document.getElementById('btn-moves');
  if(!running||paused||aiEnabled){
    btn.disabled=true;btn.classList.remove('active');
    movBtn.disabled=true;
  } else {
    btn.disabled=(hintsLeft===0);
    movBtn.disabled=false;
  }
}
 
function showToast(msg,duration=3000){
  const t=document.getElementById('hint-toast');
  t.textContent=msg;t.style.display='block';t.style.animation='hintPop 0.3s ease';
  clearTimeout(hintToastTimer);
  hintToastTimer=setTimeout(()=>t.style.display='none',duration);
}
 
function requestHint(){
  if(!running||paused||aiEnabled)return;
  if(hintsLeft<=0){showToast('❌ No hints remaining!',2000);return;}
  if(hintActive){clearHint();return;}
  const rots=allRotations(piece);
  const move=findBestMove(piece,board);
  const targetRot=rots[move.rot];
  let y=0;while(canPlace(targetRot,move.col,y+1))y++;
  hintData={piece:targetRot,x:move.col,y};
  hintActive=true;hintsLeft--;
  document.getElementById('btn-hint').classList.add('active');
  const colLabel=move.col+1,rotCount=move.rot;
  const msgs=[
    `💡 Place at column ${colLabel}${rotCount>0?' (rotate '+rotCount+'×)':''}`,
    `💡 AI suggests column ${colLabel}${rotCount>0?' with '+rotCount+' rotation':''}`,
    `💡 Best spot: col ${colLabel}${rotCount>0?', rotate '+rotCount+'×':' (no rotation)'}`,
  ];
  showToast(msgs[Math.floor(Math.random()*msgs.length)],4500);
  clearTimeout(hintTimer);hintTimer=setTimeout(clearHint,4500);
  updateHintUI();
  cancelAnimationFrame(hintAnimFrame);hintAnimate();
}
 
function clearHint(){
  hintActive=false;hintData=null;clearTimeout(hintTimer);
  document.getElementById('btn-hint').classList.remove('active');
  updateHintUI();if(running)drawBoard();
}
 
function drawHint(){
  if(!hintActive||!hintData)return;
  const{piece:hp,x:hx,y:hy}=hintData;
  hp.forEach((row,dr)=>row.forEach((v,dc)=>{
    if(!v)return;
    const px=(hx+dc)*BLOCK,py=(hy+dr)*BLOCK;
    ctx.fillStyle='rgba(255,214,0,0.18)';ctx.fillRect(px+1,py+1,BLOCK-2,BLOCK-2);
    ctx.strokeStyle='#FFD600';ctx.lineWidth=2.5;ctx.strokeRect(px+2,py+2,BLOCK-4,BLOCK-4);
  }));
  // Bouncing arrow
  const topRow=hp.findIndex(r=>r.some(v=>v));
  const midX=(hx+hp[0].length/2)*BLOCK;
  const arrowY=Math.max(8,(hy+topRow)*BLOCK-10);
  const bounce=Math.sin(Date.now()/300)*5;
  ctx.save();
  ctx.fillStyle='#FFD600';ctx.shadowColor='#FFD600';ctx.shadowBlur=14;
  ctx.fillRect(midX-2,arrowY+bounce-18,4,14);
  ctx.beginPath();ctx.moveTo(midX-9,arrowY+bounce-6);ctx.lineTo(midX+9,arrowY+bounce-6);ctx.lineTo(midX,arrowY+bounce+4);ctx.closePath();ctx.fill();
  // "AI BEST" label
  const labelY=(hy+hp.length)*BLOCK+5;
  if(labelY<canvas.height-5){
    ctx.font='bold 9px Courier New';ctx.fillStyle='#FFD600';ctx.shadowBlur=8;ctx.textAlign='left';
    ctx.fillText('AI BEST',hx*BLOCK+2,labelY+10);
  }
  ctx.restore();
}
 
function hintAnimate(){
  if(!hintActive&&!movesActive){cancelAnimationFrame(hintAnimFrame);return;}
  drawBoard();
  hintAnimFrame=requestAnimationFrame(hintAnimate);
}
 
// ══════════════════════════════════════════
// GAME LOGIC
// ══════════════════════════════════════════
function canPlace(p,x,y,b=board){
  return p.every((row,dr)=>row.every((v,dc)=>{
    if(!v)return true;
    const nr=y+dr,nc=x+dc;
    return nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&!b[nr][nc];
  }));
}
 
function spawnPiece(){
  pieceType=nextType||randPiece();nextType=randPiece();
  piece=PIECES[pieceType];
  pieceX=Math.floor(COLS/2)-Math.ceil(piece[0].length/2);pieceY=0;
  drawPreview();clearHint();
  if(movesActive)refreshMovesIfOpen();
  if(!canPlace(piece,pieceX,pieceY))endGame();
}
 
function rotatePiece(){
  const rot=rotateMatrix(piece);
  if(canPlace(rot,pieceX,pieceY)){piece=rot;}
  else if(canPlace(rot,pieceX-1,pieceY)){piece=rot;pieceX--;}
  else if(canPlace(rot,pieceX+1,pieceY)){piece=rot;pieceX++;}
}
 
function lockPiece(){
  piece.forEach((row,dr)=>row.forEach((v,dc)=>{if(v)board[pieceY+dr][pieceX+dc]=pieceType;}));
  clearLines();spawnPiece();
}
 
function clearLines(){
  let cleared=0;
  for(let r=ROWS-1;r>=0;r--){
    if(board[r].every(c=>c)){board.splice(r,1);board.unshift(new Array(COLS).fill(0));cleared++;r++;}
  }
  if(cleared){
    const pts=[0,100,300,500,800];
    score+=pts[cleared]*level;lines+=cleared;
    level=Math.floor(lines/10)+startingLevel;
    document.getElementById('score-val').textContent=score;
    document.getElementById('lines-val').textContent=lines;
    document.getElementById('level-val').textContent=level;
  }
}
 
function tick(){
  if(!running||paused)return;
  if(canPlace(piece,pieceX,pieceY+1))pieceY++;
  else lockPiece();
  drawBoard();
}
 
function getSpeed(){return Math.max(80,800-level*70);}
function startGameLoop(){clearInterval(gameLoop);gameLoop=setInterval(tick,getSpeed());}
 
// ══════════════════════════════════════════
// AI BOT
// ══════════════════════════════════════════
function aiStep(){
  if(!running||paused||!aiEnabled)return;
  if(aiPhase==='think'){
    const rots=allRotations(piece);
    const move=findBestMove(piece,board);
    const targetRot=rots[move.rot];
    let rotCount=0,sim=piece;
    for(let i=0;i<4;i++){if(sim.flat().join(',')===targetRot.flat().join(','))break;sim=rotateMatrix(sim);rotCount++;}
    aiTarget={rotationsLeft:rotCount,targetX:move.col};aiPhase='rotate';return;
  }
  if(aiPhase==='rotate'){
    if(aiTarget.rotationsLeft>0){rotatePiece();aiTarget.rotationsLeft--;drawBoard();return;}
    aiPhase='move';
  }
  if(aiPhase==='move'){
    if(pieceX<aiTarget.targetX&&canPlace(piece,pieceX+1,pieceY)){pieceX++;drawBoard();return;}
    if(pieceX>aiTarget.targetX&&canPlace(piece,pieceX-1,pieceY)){pieceX--;drawBoard();return;}
    aiPhase='drop';
  }
  if(aiPhase==='drop'){
    while(canPlace(piece,pieceX,pieceY+1))pieceY++;
    lockPiece();drawBoard();aiMoveCount++;aiPhase='think';
    const now=Date.now();
    if(now-aiMpsTimer>1000){document.getElementById('ai-mps').textContent=aiMoveCount;aiMoveCount=0;aiMpsTimer=now;}
    startGameLoop();
  }
}
 
function startAILoop(){clearInterval(aiLoop);if(!aiEnabled)return;aiLoop=setInterval(aiStep,Number(document.getElementById('speed-slider').value));}
document.getElementById('speed-slider').addEventListener('input',()=>{if(aiEnabled&&running)startAILoop();});
 
function toggleAI(){
  aiEnabled=!aiEnabled;
  const btn=document.getElementById('btn-ai');
  const lbl=document.getElementById('ai-mode-lbl');
  const mobs=document.querySelectorAll('.mc-btn');
  if(aiEnabled){
    btn.textContent='🤖 AI: ON';btn.classList.add('active');
    lbl.textContent='AI (Greedy)';aiPhase='think';aiMpsTimer=Date.now();
    mobs.forEach(b=>b.disabled=true);
    clearHint();hideMoves();
    if(running&&!paused)startAILoop();
  } else {
    btn.textContent='🤖 AI: OFF';btn.classList.remove('active');
    lbl.textContent='Manual';
    document.getElementById('ai-mps').textContent='—';
    mobs.forEach(b=>b.disabled=false);clearInterval(aiLoop);
  }
  updateHintUI();
}
 
// ══════════════════════════════════════════
// GAME LIFECYCLE
// ══════════════════════════════════════════
function initGame(){
  level=startingLevel;document.getElementById('level-val').textContent=level;
  hintsLeft=MAX_HINTS;updateHintUI();drawBoard();
  if(startAiOnLaunch&&!aiEnabled)toggleAI();
  overlay.style.display='flex';
  oTitle.textContent='HI, '+playerName.toUpperCase()+'!';
  oSub.textContent='Press Start';
}
 
function startGame(){
  board=newBoard();score=0;lines=0;level=startingLevel;
  running=true;paused=false;aiPhase='think';
  hintsLeft=MAX_HINTS;clearHint();hideMoves();
  document.getElementById('score-val').textContent='0';
  document.getElementById('lines-val').textContent='0';
  document.getElementById('level-val').textContent=level;
  document.getElementById('btn-pause').disabled=false;
  document.getElementById('btn-pause').textContent='⏸ Pause';
  overlay.style.display='none';
  nextType=null;spawnPiece();startGameLoop();
  if(aiEnabled){aiPhase='think';startAILoop();}
  updateHintUI();drawBoard();
}
 
function togglePause(){
  if(!running)return;
  paused=!paused;
  document.getElementById('btn-pause').textContent=paused?'▶ Resume':'⏸ Pause';
  if(paused){
    overlay.style.display='flex';oTitle.textContent='PAUSED';oSub.textContent='Press P to resume';
    clearInterval(aiLoop);clearHint();hideMoves();
  } else {
    overlay.style.display='none';
    if(aiEnabled){aiPhase='think';startAILoop();}
  }
  updateHintUI();
}
 
function endGame(){
  running=false;clearInterval(gameLoop);clearInterval(aiLoop);clearHint();hideMoves();
  overlay.style.display='flex';
  oTitle.textContent='GAME OVER';
  oSub.textContent=playerName+'  •  Score: '+score;
  document.getElementById('btn-pause').disabled=true;
  document.getElementById('btn-pause').textContent='⏸ Pause';
  updateHintUI();
}
 
function hardDrop(){
  while(canPlace(piece,pieceX,pieceY+1)){pieceY++;score+=2;}
  lockPiece();drawBoard();
  document.getElementById('score-val').textContent=score;
  startGameLoop();
}
 
// ══════════════════════════════════════════
// KEYBOARD
// ══════════════════════════════════════════
document.addEventListener('keydown',e=>{
  if(e.key==='a'||e.key==='A'){toggleAI();return;}
  if(e.key==='h'||e.key==='H'){requestHint();return;}
  if(e.key==='m'||e.key==='M'){toggleMoves();return;}
  if(aiEnabled)return;
  if(!running||paused){if((e.key==='p'||e.key==='P')&&paused)togglePause();return;}
  switch(e.key){
    case 'ArrowLeft':  if(canPlace(piece,pieceX-1,pieceY))pieceX--;break;
    case 'ArrowRight': if(canPlace(piece,pieceX+1,pieceY))pieceX++;break;
    case 'ArrowDown':
      if(canPlace(piece,pieceX,pieceY+1)){pieceY++;score++;document.getElementById('score-val').textContent=score;}break;
    case 'ArrowUp':case 'x':case 'X':rotatePiece();break;
    case ' ':e.preventDefault();hardDrop();return;
    case 'p':case 'P':togglePause();return;
  }
  drawBoard();
});
 
// ══════════════════════════════════════════
// MOBILE CONTROLS
// ══════════════════════════════════════════
document.getElementById('mc-left').onclick=()=>{if(running&&!paused&&!aiEnabled&&canPlace(piece,pieceX-1,pieceY)){pieceX--;drawBoard();}};
document.getElementById('mc-right').onclick=()=>{if(running&&!paused&&!aiEnabled&&canPlace(piece,pieceX+1,pieceY)){pieceX++;drawBoard();}};
document.getElementById('mc-down').onclick=()=>{if(running&&!paused&&!aiEnabled&&canPlace(piece,pieceX,pieceY+1)){pieceY++;score++;document.getElementById('score-val').textContent=score;drawBoard();}};
document.getElementById('mc-rot').onclick=()=>{if(running&&!paused&&!aiEnabled){rotatePiece();drawBoard();}};
document.getElementById('mc-drop').onclick=()=>{if(running&&!paused&&!aiEnabled)hardDrop();};
 
setInterval(()=>{if(running&&!paused)startGameLoop();},800);
</script>
